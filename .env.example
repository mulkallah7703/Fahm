# ---------------------------------------------------------------------------
# FAHM environment — copy to .env and fill in real values.
# Never commit secrets.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

# JWT — generate a long random secret for production
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# SQL Server (existing FAHM database — do not create another)
# windows = current Windows login (SQL Express local)
# sql     = SQL authentication with DB_USER / DB_PASSWORD
DB_AUTH=windows
DB_SERVER=localhost
DB_INSTANCE=SQLEXPRESS
DB_DATABASE=Fahm
DB_PORT=1433
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server

# Object storage (local for development; swap provider later)
STORAGE_PROVIDER=local
STORAGE_ROOT=./storage/uploads
STORAGE_PUBLIC_BASE=/api/materials

# Upload limits
MAX_UPLOAD_SIZE_MB=15
MAX_TEXT_LENGTH=50000

# Cookie
COOKIE_NAME=fahm_token
COOKIE_SECURE=false

# Optional — Gemini multimodal teaching (server only). Never prefix with VITE_.
GEMINI_API_KEY=
GEMINI_ANALYSIS_MODEL=gemini-2.0-flash
GEMINI_TEACHING_MODEL=gemini-2.0-flash

# Optional — Vision + concept extraction use OpenAI when set.
# Without a key, FAHM falls back to local OCR-based analysis.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_TEXT_MODEL=gpt-4o-mini

# Optional — backend TTS. Without a key, Blind Mode uses the browser Speech API.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_VOICE_MALE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
